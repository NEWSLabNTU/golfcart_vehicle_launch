<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- load parameter -->
  <xacro:property name="vehicle_info" value="${xacro.load_yaml('$(find golfcart_vehicle_description)/config/vehicle_info.param.yaml')}"/>

  <!-- vehicle body: the cart as it stands in 2026 (body, sensor housings, wheels).
       mesh/golfcart.dae is generated by 2026-golf-cart's
       src/simulation/golfcart_twin/body/make_vehicle_mesh.py, in Autoware's vehicle mesh frame
       (as sample_vehicle_description's lexus.dae): Y up, facing -X, origin on the ground at mid
       wheelbase. Regenerate it there; do not edit it by hand. -->
  <link name="base_link">
    <visual>
      <origin xyz="${vehicle_info['/**']['ros__parameters']['wheel_base']/2.0} 0 0" rpy="${pi/2.0} 0 ${pi}"/>
      <geometry>
        <mesh filename="package://golfcart_vehicle_description/mesh/golfcart.dae" scale="1 1 1"/>
      </geometry>
    </visual>
  </link>
</robot>
