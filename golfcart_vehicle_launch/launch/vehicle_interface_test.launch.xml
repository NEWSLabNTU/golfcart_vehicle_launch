<?xml version="1.0" encoding="UTF-8"?>
<!--
  Standalone bench/test launch for golfcart_vehicle_interface.

  Runs the vehicle interface node by itself with CAN TX disabled by default
  so the cart cannot be commanded into motion. Use against a real bus, a
  vcan0 loopback, or any interface that simply exists — RX still flows so
  /vehicle/status/* and /diagnostics are populated.

  Override `tx_enabled:=true` only when you intend to actually drive.
-->
<launch>
  <arg name="can_interface" default="can0" description="SocketCAN interface (real or vcan)"/>
  <arg name="tx_enabled" default="false" description="CAN TX master enable. Defaults to false for safety on this test launch."/>
  <arg name="param_file" default="$(find-pkg-share golfcart_vehicle_launch)/config/vehicle_interface.param.yaml"/>

  <node pkg="golfcart_vehicle_interface" exec="golfcart_vehicle_interface" name="vehicle_interface" output="screen">
    <param from="$(var param_file)"/>
    <param name="can_interface" value="$(var can_interface)"/>
    <param name="tx_enabled" value="$(var tx_enabled)"/>

    <remap from="~/input/control_cmd" to="/control/command/control_cmd"/>
    <remap from="~/input/gear_cmd" to="/control/command/gear_cmd"/>
    <remap from="~/input/turn_indicators_cmd" to="/control/command/turn_indicators_cmd"/>
    <remap from="~/input/hazard_lights_cmd" to="/control/command/hazard_lights_cmd"/>
    <remap from="~/input/control_mode_request" to="/control/control_mode_request"/>
    <remap from="~/input/emergency_stop" to="/vehicle/emergency_stop"/>
    <remap from="~/input/emergency_cmd" to="/control/command/emergency_cmd"/>

    <remap from="~/output/velocity_status" to="/vehicle/status/velocity_status"/>
    <remap from="~/output/steering_status" to="/vehicle/status/steering_status"/>
    <remap from="~/output/gear_status" to="/vehicle/status/gear_status"/>
    <remap from="~/output/control_mode" to="/vehicle/status/control_mode"/>
    <remap from="~/output/turn_indicators_status" to="/vehicle/status/turn_indicators_status"/>
    <remap from="~/output/hazard_lights_status" to="/vehicle/status/hazard_lights_status"/>
    <remap from="~/output/actuation_status" to="/vehicle/status/actuation_status"/>
  </node>
</launch>
