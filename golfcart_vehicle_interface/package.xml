<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>golfcart_vehicle_interface</name>
  <version>0.1.0</version>
  <description>CAN bus vehicle interface for the golf cart (CAX_ADS protocol).</description>
  <maintainer email="d10922013@csie.ntu.edu.tw">James Lee</maintainer>
  <license>Apache-2.0</license>

  <depend>rclrs</depend>
  <depend>builtin_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>autoware_control_msgs</depend>
  <depend>autoware_vehicle_msgs</depend>
  <depend>tier4_vehicle_msgs</depend>

  <!--
    Not used by this package. rclrs 0.7.0 vendors bindings for test_msgs
    (rclrs-0.7.0/src/vendor/test_msgs/) and links them unconditionally, so the
    package fails to link without it:

      rust-lld: error: unable to find library -ltest_msgs__rosidl_typesupport_c

    Declared here so rosdep installs it. Remove only when rclrs stops linking
    it, not because it looks unused.
  -->
  <depend>test_msgs</depend>

  <export>
    <build_type>ament_cargo</build_type>
  </export>
</package>
